# =============================================================================
# PICKKET.GO 환경변수 템플릿
# =============================================================================
# 사용법: cp .env.example .env.local → 값 채우기
# 주의: 시크릿은 .env.local에만 저장, git 커밋 금지
# =============================================================================

# ───────────────────────── Database ─────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=pickket
PG_PASSWORD=change-in-production
PG_DATABASE=pickket
PG_POOL_MAX=20
PG_SSL=false

# ───────────────────────── Redis ─────────────────────────
# Rate limit / 웹훅 idempotency / Smart Queue / 봇방어 / 부정행위 탐지
REDIS_URL=redis://localhost:6379

# ───────────────────────── 보안 (프로덕션 필수 변경) ─────────────────────────
SESSION_SIGNING_KEY=generate-random-64-char-string-here
SESSION_SECRET=generate-random-32-char-minimum
CRON_SECRET=generate-random-secret-here
QR_SECRET=generate-random-secret-for-qr-signing
OTP_PEPPER=generate-random-otp-pepper
IDENTITY_HASH_PEPPER=generate-random-identity-pepper
# 발송 토큰 전용 시크릿 — 프로덕션 필수(누락 시 수신거부/클릭 토큰 발급이 실패한다, fail-close)
UNSUBSCRIBE_SECRET=generate-random-secret-for-unsubscribe-tokens
MESSAGE_TRACKING_SECRET=generate-random-secret-for-tracking-tokens

# ───────────────────────── 앱 설정 ─────────────────────────
NODE_ENV=development
BASE_URL=http://localhost:3013
NEXT_PUBLIC_APP_URL=http://localhost:3013
NEXT_PUBLIC_V2_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3013
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3013,http://localhost:3000
LOG_LEVEL=info

# ───────────────────────── 회사 정보 (공개 푸터/인보이스용) ─────────────────────────
NEXT_PUBLIC_COMPANY_NAME=픽켓
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시
NEXT_PUBLIC_CONTACT_EMAIL=support@pickket.kr
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_BUSINESS_NUMBER=
NEXT_PUBLIC_ECOMMERCE_NUMBER=

# 계좌이체 안내 (구매자 화면 표시용)
NEXT_PUBLIC_BANK_NAME=국민은행
NEXT_PUBLIC_BANK_ACCOUNT=123-456-789012
NEXT_PUBLIC_BANK_HOLDER=픽켓

# ───────────────────────── 결제 PG provider 선택 ─────────────────────────
# 신규 주문의 기본 온라인 PG (toss | nicepay). 미설정 시 toss(기존 동작).
# ⚠️ 결정 B(서버주도): checkout/initiate 응답이 provider 를 항상 내려주고 프론트가 그 값으로
#    결제창을 분기한다(env 는 서버가 못 읽을 때만 폴백). 서버는 아래 PAYMENT_PROVIDER 를,
#    없으면 NEXT_PUBLIC_PAYMENT_PROVIDER 를 읽는다.
PAYMENT_PROVIDER=toss
NEXT_PUBLIC_PAYMENT_PROVIDER=toss

# ───────────────────────── 결제 PG: Toss Payments ─────────────────────────
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# ───────────────────────── 결제 PG: NICEPAY (신형 API v1) ─────────────────────────
# ⚠️ clientKey 만 프론트에 노출(G4). secretKey 는 organizer 에 두지 않는다(승인·취소·서명 전부 v2 소유).
# 결제창 returnUrl = NEXT_PUBLIC_V2_API_URL + /api/v1/payments/nice/return (v2 엔드포인트).
NEXT_PUBLIC_NICEPAY_CLIENT_KEY=

# ───────────────────────── 결제 PG: Kakao Pay ─────────────────────────
KAKAO_ADMIN_KEY=
KAKAO_CID=
KAKAO_WEBHOOK_SECRET=

# ───────────────────────── 결제 PG: Naver Pay ─────────────────────────
NAVERPAY_PARTNER_ID=
NAVERPAY_CLIENT_ID=
NAVERPAY_CLIENT_SECRET=
NAVER_WEBHOOK_SECRET=

# ───────────────────────── 결제 PG: PortOne (통합 게이트웨이, 병행) ─────────────────────────
# Phase 5A-6: Toss/Kakao/Naver 직접 연동과 병행. mock_mode=true면 실제 호출 없음.
PORTONE_MOCK_MODE=true
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_ENABLED=false

# ───────────────────────── 내부 통신 / 워커 ─────────────────────────
GO_WEBHOOK_SECRET=
INBOUND_EMAIL_SECRET=
ALIMTALK_ENABLED=false
SOLAPI_PF_ID=
WORKER_CONCURRENCY=5

# ───────────────────────── 웹훅 공통 ─────────────────────────
# Phase 5A-3: 웹훅 타임스탬프 허용 범위(초). 초과 시 replay로 간주하고 거부.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=60

# ───────────────────────── 좌석 홀드 ─────────────────────────
# Phase 5A-4: 좌석 홀드 TTL(초). reaper가 이 시간 지난 홀드를 자동 릴리즈.
SEAT_HOLD_TTL_SECONDS=600

# ───────────────────────── SMS Provider (OTP / 알림) ─────────────────────────
# stub=콘솔 출력만 / ncp=NCP SENS 실발송(운영) / solapi=레거시
SMS_PROVIDER=stub
# 레거시(Solapi) — ncp 전환 후 미사용
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=

# ───────────────────────── 실명인증 Provider ─────────────────────────
# Phase 5B-2: stub=개발/테스트 / nice=NICE 표준창 / kcb=KCB / pcc=PCC / toss_cert=Toss 본인인증
IDENTITY_PROVIDER=stub
NICE_SITE_CODE=
NICE_SITE_PASSWORD=
KCB_CLIENT_ID=
KCB_CLIENT_SECRET=
IDENTITY_RETURN_URL=http://localhost:3013/api/identity/callback
IDENTITY_ENC_KEY=

# ───────────────────────── Wallet (선택) ─────────────────────────
APPLE_PASS_CERT=
APPLE_PASS_KEY=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=

# ───────────────────────── 챗봇 (v2 라우팅) ─────────────────────────
# go 자체 AI/지식 기능은 폐기됨(레벨2 영역B). 공개 이벤트 챗봇은 아래 V2_INTERNAL_BASE_URL 을
# 통해 v2 `/api/v1/chat`(chatbot_service)로 라우팅된다. ANTHROPIC_API_KEY·AI_MODEL_* 는 더 이상 불필요.

# ───────────────────────── RISE Engine (v2 통합) ─────────────────────────
# v2 RISE 엔진 URL (Docker). 설정 안 하면 헬스체크에서 skip.
RISE_ENGINE_URL=http://localhost:8100

# ───────────────────────── 발송(NCP 통일: 이메일·SMS·알림톡) ─────────────────────────
# 프로덕션에서 미설정 시 각 발송 API 는 명시적으로 실패한다(무음 시뮬레이션 아님).
#
# 공통 인증키 (IAM 서브계정) — 이메일/SMS/알림톡 3종 공용
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
#
# 이메일 — Cloud Outbound Mailer. 발신주소는 콘솔에서 도메인 인증(SPF/DKIM/DMARC) 후 등록.
MAILER_SENDER_ADDRESS=support@pickket.kr
MAILER_SENDER_NAME=PICKKET
#
# SMS — SENS SMS. serviceId + 등록 발신번호. (OTP 는 SMS_PROVIDER=ncp 로 이 값 공용)
SENS_SMS_SERVICE_ID=
SENS_SMS_FROM=
#
# 카카오 알림톡 — SENS AlimTalk. 별도 serviceId + 연동한 카카오 채널ID(@채널, plusFriendId).
SENS_ALIMTALK_SERVICE_ID=
SENS_ALIMTALK_CHANNEL_ID=
REFUND_NOTIFY_EMAIL=

# ───────────────────────── S3 스토리지 (이미지 업로드) ─────────────────────────
# v2와 동일 S3 버킷 공유, go/ prefix 분리. Presigned URL PUT 방식.
UPLOAD_PROVIDER=s3
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_ENDPOINT_URL=

# ───────────────────────── v2 연동 (이벤트 동기화 + 웹훅) ─────────────────────────
# GO→v2 이벤트 push (A안): 이벤트 생성/수정/삭제 시 v2에 자동 동기화
V2_INTERNAL_BASE_URL=https://api-staging.pickket.kr
# 웹훅 검증 시크릿. v2 sender 는 GO_WEBHOOK_SECRET 으로 서명하므로 두 값을 동일하게 두는 것을 권장.
V2_EVENT_SYNC_SECRET=
V2_JWT_SECRET=
# v2 가 발급하는 JWT 의 iss/aud 정본값 (v2 core/config.py 기준).
# 이 값이 v2 발급값과 다르면 verifyV2AccessToken 이 전 토큰을 거부 → 대시보드 인증 전면 실패.
V2_JWT_ISSUER=pickket-api
V2_JWT_AUDIENCE=pickket-clients

# v2→GO 주문 웹훅 수신: v2가 주문 상태 변경 시 GO에 push
V2_WEBHOOK_SECRET=

# ───────────────────────── Sentry (에러 추적/APM) ─────────────────────────
# sentry.io 프로젝트 생성 후 DSN 입력. 미설정 시 Sentry 비활성.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ───────────────────────── 테스트 (CI/Playwright) ─────────────────────────
# PLAYWRIGHT_TEST=1 설정 시 rate limit 우회 (E2E 테스트용)
PLAYWRIGHT_TEST=

# [E2E 전용] v2 DB 직접 연결(테스트 픽스처 위생용). provision-v2-events.ts 가
# stale organizer_profile 재링크에 사용. prod 미사용.
V2_TEST_DATABASE_URL=postgresql://USER:PASS@HOST:5435/pickket_v2_dev

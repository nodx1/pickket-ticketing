# PICKKET 백업 연결정보 — 실제 값은 scripts/ops/backup.env 에 넣을 것(gitignore, 커밋 금지).
# 대표 승인 후 prod DB 접속정보로 채운다. 두 DB 각각.
#
#   cp scripts/ops/backup.env.example scripts/ops/backup.env
#   # 아래 값을 실제 prod 접속정보로 교체
#
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
# host: X99 프로덕션 DB(pickket-db / pickket-go-db). 이 워크스테이션에서 닿는 경로로 지정
#   (예: CapRover 포트 노출 시 192.168.0.9:<port>, 또는 X99에서 실행 시 컨테이너 내부 host).

PG_V2_URL="postgresql://USER:PASS@HOST:PORT/pickket"
PG_GO_URL="postgresql://USER:PASS@HOST:PORT/pickket_go"

# 선택: 대상/보존 오버라이드
# BACKUP_DEST=/home/oem/storage/pickket-backups
# BACKUP_RETAIN_DAYS=14

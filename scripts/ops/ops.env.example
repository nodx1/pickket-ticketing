# PICKKET 운영 스크립트 설정 — 복사해서 scripts/ops/ops.env 로 (ops.env 는 git 제외)
# cp scripts/ops/ops.env.example scripts/ops/ops.env

# ntfy.sh 폰 푸시 토픽 — 비공개 난수로 생성할 것 (예: pickket-ops-$(openssl rand -hex 8))
# 휴대폰에 ntfy 앱 설치 후 이 토픽 구독. 미설정이면 폰 푸시 생략(데스크톱 알림만).
NTFY_TOPIC=

# 이상 감지 시 claude -p 헤드리스 진단 소환 여부 (1=on). 비용 발생. 기본 off.
SENTINEL_AI_DIAGNOSIS=0

# CapRover (배포 스크립트용) — 비번은 여기 대신 시크릿 파일 참조 권장
CAPROVER_URL=http://192.168.0.9:3000
# CAPROVER_PASSWORD=   # 미설정 시 배포 스크립트가 프롬프트로 물어봄

# 백업 검증 — X99 백업 경로가 생기면 설정 (P0-B 완료 후)
# BACKUP_CHECK_SSH=ofc@192.168.0.9
# BACKUP_CHECK_PATH=/path/to/backups

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@pickket/lib/api": [
        "../platform/packages/lib/src/api.ts"
      ],
      "@pickket/lib/*": [
        "../platform/packages/lib/src/*"
      ],
      "@pickket/store/*": [
        "../platform/packages/store/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}

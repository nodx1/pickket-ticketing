# Pickket Mobile 환경변수
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# EAS Build 사용 시 eas.json > build > [profile] > env 에서도 설정 가능합니다.

# API 서버 URL
# dev (Android): http://10.0.2.2:8021
# dev (iOS): http://localhost:8021
# staging: https://api-stg.pickket.kr
# production: https://api.pickket.kr
EXPO_PUBLIC_API_URL=http://localhost:8021

# PortOne 결제 (프로덕션 키는 eas.json production.env에 설정)
EXPO_PUBLIC_PORTONE_CHANNEL_KEY=
EXPO_PUBLIC_PORTONE_STORE_ID=

# Sentry 에러 모니터링
EXPO_PUBLIC_SENTRY_DSN=

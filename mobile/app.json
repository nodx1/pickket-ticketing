{
  "expo": {
    "name": "Pickket",
    "slug": "pickket",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9f62bb1b-90ea-40fd-9a08-38b92932ec7c"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pickket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.pickket.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:pickket.kr",
        "applinks:www.pickket.kr"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Pickket 앱 보안을 위해 Face ID를 사용합니다. / Pickket uses Face ID to secure your account.",
        "NSLocationWhenInUseUsageDescription": "주변 공연장의 이벤트를 알려드리기 위해 위치 정보를 사용합니다. / We use your location to show nearby events.",
        "NSCameraUsageDescription": "팬 스탬프 촬영 및 프로필 사진 등록을 위해 카메라를 사용합니다. / We use the camera for fan stamps and profile photos.",
        "NSPhotoLibraryUsageDescription": "갤러리 사진으로 팬 스탬프를 만들기 위해 접근합니다. / We access your photo library to create fan stamps.",
        "NSPhotoLibraryAddUsageDescription": "만든 팬 스탬프를 사진에 저장합니다. / We save completed fan stamps to your photo library.",
        "NSMicrophoneUsageDescription": "음성 검색 기능을 위해 마이크를 사용합니다. / We use the microphone for voice search.",
        "NSSpeechRecognitionUsageDescription": "음성 검색 기능을 위해 음성 인식을 사용합니다. / We use speech recognition for voice search.",
        "LSApplicationQueriesSchemes": [
          "kakaotalk",
          "naversearchapp",
          "googlegmail"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePaymentInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0E"
      },
      "edgeToEdgeEnabled": true,
      "package": "kr.pickket.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/events" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/tickets" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/orders" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/e" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/wallet" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/fan-stamp" },
            { "scheme": "https", "host": "pickket.kr", "pathPrefix": "/schedule" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pickket 앱 보안을 위해 Face ID를 사용합니다."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 공연장의 이벤트를 알려드리기 위해 위치 정보를 사용합니다."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF3366"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "9f62bb1b-90ea-40fd-9a08-38b92932ec7c"
      },
      "router": {}
    },
    "owner": "onlywon"
  }
}

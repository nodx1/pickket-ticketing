{
  "TaskTemplate": {
    "ContainerSpec": {
      "Command": [
        "celery",
        "-A",
        "app.core.celery_app:celery_app",
        "worker",
        "--loglevel=info",
        "--concurrency=2"
      ],
      "Healthcheck": {
        "Test": [
          "CMD-SHELL",
          "celery -A app.core.celery_app:celery_app inspect ping --timeout 5 || exit 1"
        ],
        "Interval": 60000000000,
        "Timeout": 10000000000,
        "Retries": 3,
        "StartPeriod": 30000000000
      }
    }
  },
  "UpdateConfig": {
    "Order": "stop-first"
  }
}

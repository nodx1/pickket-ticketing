# Phase 0: Data Layer Environment Variables
# Replace <placeholders> with actual values from Aurora/Redis provisioning output

# Aurora Serverless v2
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<aurora-proxy-endpoint>:5432/pickket_v2?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<pass>@<aurora-proxy-endpoint>:5432/pickket_v2?sslmode=require
DATABASE_READ_URL=postgresql+asyncpg://<user>:<pass>@<aurora-reader-endpoint>:5432/pickket_v2?ssl=require
DB_REQUIRE_SSL=true
DB_PGBOUNCER_MODE=true

# Redis Cluster Mode
REDIS_CLUSTER_MODE=true
REDIS_CLUSTER_NODES=<config-endpoint>:6379

# Phase 1: External Service Environment Variables
# Replace <placeholders> with actual credentials

# Payment (PortOne)
PORTONE_MOCK_MODE=false
PORTONE_API_SECRET=<from-portone-console>
PORTONE_STORE_ID=<store-id>
PORTONE_CHANNEL_KEY=<channel-key>
PORTONE_WEBHOOK_SECRET=<webhook-secret>
PORTONE_WEBHOOK_REQUIRE_TIMESTAMP=true

# Email (SES)
EMAIL_PROVIDER=ses
AWS_SES_SENDER=support@pickket.kr

# SMS (NCP)
SMS_PROVIDER=ncp
NCP_SMS_ACCESS_KEY=<key>
NCP_SMS_SECRET_KEY=<key>
NCP_SMS_SERVICE_ID=<id>
NCP_SMS_SENDER=<sender-number>

# Identity Verification
IDENTITY_PROVIDER=pass

# Upload (already configured, moved to Secrets Manager)
UPLOAD_PROVIDER=s3

# Monitoring
SENTRY_DSN=<dsn>
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=<endpoint>

# Production Security
ENVIRONMENT=production
REFRESH_COOKIE_SECURE=true
ACCESS_COOKIE_NAME=__Host-pickket_access
REFRESH_COOKIE_NAME=__Host-pickket_refresh
PAYMENT_MANUAL_API_ENABLED=false
CORS_ORIGINS=https://www.pickket.kr,https://go.pickket.kr,https://admin.pickket.kr

# TOTP (Phase 6)
TOTP_ENABLED=true
TOTP_ENCRYPTION_KEY=<fernet-key>

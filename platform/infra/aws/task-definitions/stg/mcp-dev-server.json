{
  "family": "pickket-stg-mcp-dev-server",
  "taskRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "mcp-dev-server",
      "image": "794562054294.dkr.ecr.ap-northeast-2.amazonaws.com/pickket-mcp-dev-server:staging-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8022,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "STORAGE_BACKEND", "value": "redis" },
        { "name": "REDIS_DB", "value": "2" },
        { "name": "PORT", "value": "8022" },
        { "name": "MCP_LOCK_MODE", "value": "soft" }
      ],
      "secrets": [
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/redis-url-PuRuXM"
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/telegram-bot-token-Uv25J6"
        },
        {
          "name": "TELEGRAM_CHAT_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/telegram-chat-id-Gruaew"
        },
        {
          "name": "MCP_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/mcp-auth-token-hLA9D7"
        },
        {
          "name": "MCP_ADMIN_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/mcp-admin-key-29vJug"
        },
        {
          "name": "GITHUB_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/github-webhook-secret-tssXqO"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pickket-stg/mcp-dev-server",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

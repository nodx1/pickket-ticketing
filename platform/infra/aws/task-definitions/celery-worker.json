{
  "family": "pickket-v2-celery-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "celery-worker",
      "image": "794562054294.dkr.ecr.ap-northeast-2.amazonaws.com/pickket-backend:staging-latest",
      "command": [
        "celery",
        "-A",
        "app.core.celery_app:celery_app",
        "worker",
        "--loglevel=info",
        "--concurrency=4"
      ],
      "essential": true,
      "environment": [
        { "name": "ENVIRONMENT", "value": "staging" },
        { "name": "LOG_LEVEL", "value": "INFO" }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/secret-key"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/database-url"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/redis-url"
        },
        {
          "name": "CELERY_BROKER_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/celery-broker-url"
        },
        {
          "name": "PORTONE_API_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/portone-api-secret"
        },
        {
          "name": "PORTONE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-stg/portone-webhook-secret"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "celery -A app.core.celery_app:celery_app inspect ping --timeout 5 || exit 1"
        ],
        "interval": 60,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pickket-v2/celery-worker",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

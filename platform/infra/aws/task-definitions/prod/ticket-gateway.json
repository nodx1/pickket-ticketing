{
  "family": "pickket-prod-ticket-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "ticket-gateway",
      "image": "794562054294.dkr.ecr.ap-northeast-2.amazonaws.com/pickket/ticket-gateway:prod-latest",
      "portMappings": [{ "containerPort": 8030, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "PORT", "value": "8030" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "SNS_REGION", "value": "ap-northeast-2" },
        {
          "name": "BACKEND_HEALTH_URL",
          "value": "http://pickket-alb-452124900.ap-northeast-2.elb.amazonaws.com/health"
        },
        { "name": "OTEL_ENABLED", "value": "true" },
        { "name": "OTEL_SERVICE_NAME", "value": "pickket-ticket-gateway" },
        { "name": "OTEL_EXPORTER_ENDPOINT", "value": "http://localhost:4317" }
      ],
      "secrets": [
        {
          "name": "REDIS_CLUSTER_NODES",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/redis-cluster-nodes"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/redis-password"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/secret-key"
        },
        {
          "name": "SNS_TOPIC_PURCHASE",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-topic-purchase"
        },
        {
          "name": "SNS_TOPIC_SEAT_HOLD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-topic-seat-hold"
        },
        {
          "name": "SNS_TOPIC_ADMISSION",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-topic-admission"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pickket/ticket-gateway",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8030/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    },
    {
      "name": "otel-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:v0.41.1",
      "essential": false,
      "command": ["--config", "env:AOT_CONFIG_CONTENT"],
      "portMappings": [
        { "containerPort": 4317, "protocol": "tcp" },
        { "containerPort": 4318, "protocol": "tcp" }
      ],
      "environment": [
        {
          "name": "AOT_CONFIG_CONTENT",
          "value": "receivers:\n  otlp:\n    protocols:\n      grpc:\n        endpoint: 0.0.0.0:4317\n      http:\n        endpoint: 0.0.0.0:4318\nprocessors:\n  batch:\n    timeout: 5s\n    send_batch_size: 256\nexporters:\n  awsxray:\n    region: ap-northeast-2\n  awsemf:\n    region: ap-northeast-2\n    namespace: Pickket/Application\n    log_group_name: /pickket/metrics\nservice:\n  pipelines:\n    traces:\n      receivers: [otlp]\n      processors: [batch]\n      exporters: [awsxray]\n    metrics:\n      receivers: [otlp]\n      processors: [batch]\n      exporters: [awsemf]"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pickket-prod/otel-collector",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "memory": 256
    }
  ]
}

{
  "family": "pickket-prod-celery-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::794562054294:role/pickket-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "celery-worker",
      "image": "794562054294.dkr.ecr.ap-northeast-2.amazonaws.com/pickket-backend:prod-latest",
      "command": [
        "celery",
        "-A",
        "app.core.celery_app:celery_app",
        "worker",
        "--loglevel=info",
        "--concurrency=4"
      ],
      "essential": true,
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        {
          "name": "CORS_ORIGINS",
          "value": "https://www.pickket.kr,https://pickket.kr,https://go.pickket.kr,https://admin.pickket.kr"
        },
        { "name": "PORTONE_MOCK_MODE", "value": "false" },
        { "name": "PAYMENT_MANUAL_API_ENABLED", "value": "false" },
        {
          "name": "PAYMENT_SUCCESS_URL",
          "value": "https://www.pickket.kr/payment/success"
        },
        {
          "name": "PAYMENT_FAIL_URL",
          "value": "https://www.pickket.kr/payment/fail"
        },
        { "name": "ADMIN_MFA_REQUIRED", "value": "true" },
        { "name": "TOTP_ENABLED", "value": "true" },
        { "name": "IDENTITY_PROVIDER", "value": "pass" },
        { "name": "EMAIL_PROVIDER", "value": "ses" },
        { "name": "SMS_PROVIDER", "value": "ncp" },
        { "name": "DB_REQUIRE_SSL", "value": "true" },
        { "name": "REFRESH_COOKIE_SECURE", "value": "true" },
        { "name": "REFRESH_COOKIE_DOMAIN", "value": ".pickket.kr" },
        { "name": "REFRESH_COOKIE_SAMESITE", "value": "lax" },
        { "name": "GO_INTERNAL_BASE_URL", "value": "https://go.pickket.kr" },
        { "name": "TRUSTED_PROXY_CIDRS", "value": "10.0.0.0/16" },
        { "name": "PORTONE_WEBHOOK_REQUIRE_TIMESTAMP", "value": "true" },
        { "name": "UPLOAD_PROVIDER", "value": "s3" },
        { "name": "S3_BUCKET", "value": "pickket-uploads" },
        { "name": "S3_REGION", "value": "auto" },
        {
          "name": "S3_ENDPOINT_URL",
          "value": "https://9fa16ac13c7beb314b0a0ddc0f374c22.r2.cloudflarestorage.com"
        },
        {
          "name": "S3_PUBLIC_URL",
          "value": "https://pub-e2742c598b854b65960d364f90957772.r2.dev"
        },
        { "name": "REDIS_CLUSTER_MODE", "value": "true" }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/secret-key"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/database-url"
        },
        {
          "name": "DATABASE_URL_SYNC",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/database-url-sync"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/redis-url"
        },
        {
          "name": "CELERY_BROKER_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/celery-broker-url"
        },
        {
          "name": "CELERY_RESULT_BACKEND",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/celery-result-backend"
        },
        {
          "name": "S3_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/s3-access-key"
        },
        {
          "name": "S3_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/s3-secret-key"
        },
        {
          "name": "PORTONE_API_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/portone-api-secret"
        },
        {
          "name": "PORTONE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/portone-webhook-secret"
        },
        {
          "name": "SENTRY_DSN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sentry-dsn"
        },
        {
          "name": "REDIS_CLUSTER_NODES",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/redis-cluster-nodes"
        },
        {
          "name": "PII_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/pii-encryption-key"
        },
        {
          "name": "GO_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/go-webhook-secret"
        },
        {
          "name": "SNS_ORDER_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-order-topic-arn"
        },
        {
          "name": "SNS_PAYMENT_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-payment-topic-arn"
        },
        {
          "name": "SNS_TICKET_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-ticket-topic-arn"
        },
        {
          "name": "SNS_SEAT_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-seat-topic-arn"
        },
        {
          "name": "SNS_QUEUE_TOPIC_ARN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sns-queue-topic-arn"
        },
        {
          "name": "SQS_ORDER_PROCESSING_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sqs-order-processing-url"
        },
        {
          "name": "SQS_PAYMENT_PROCESSING_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sqs-payment-processing-url"
        },
        {
          "name": "SQS_SEAT_SYNC_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sqs-seat-sync-url"
        },
        {
          "name": "SQS_TICKET_NOTIFICATIONS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:794562054294:secret:pickket-prod/sqs-ticket-notifications-url"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "celery -A app.core.celery_app:celery_app inspect ping --timeout 5 || exit 1"
        ],
        "interval": 60,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pickket-prod/celery-worker",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

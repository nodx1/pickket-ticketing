# === Core ===
ENVIRONMENT=production
SECRET_KEY=                          # Min 32 chars, required

# === Database ===
DATABASE_URL=postgresql+asyncpg://user:pass@rds-endpoint:5432/pickket
DATABASE_URL_SYNC=postgresql://user:pass@rds-endpoint:5432/pickket
DATABASE_READ_URL=                   # RDS read replica endpoint (optional)

# === Redis ===
REDIS_URL=redis://elasticache-endpoint:6379/0
CELERY_BROKER_URL=redis://elasticache-endpoint:6379/1
CELERY_RESULT_BACKEND=redis://elasticache-endpoint:6379/2

# === Domain / CORS ===
CORS_ORIGINS=https://www.pickket.kr,https://pickket.kr,https://go.pickket.kr,https://admin.pickket.kr
CDN_BASE_URL=https://www.pickket.kr
EMAIL_FROM_ADDRESS=support@pickket.kr

# === Payment (PortOne) ===
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://www.pickket.kr/payment/success
PAYMENT_FAIL_URL=https://www.pickket.kr/payment/fail

# === Storage (Cloudflare R2) ===
UPLOAD_PROVIDER=s3
S3_BUCKET=pickket-uploads
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=https://9fa16ac13c7beb314b0a0ddc0f374c22.r2.cloudflarestorage.com

# === Email ===
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-northeast-2

# === SMS ===
SMS_PROVIDER=ncp
NCP_SMS_SERVICE_ID=
NCP_SMS_ACCESS_KEY=
NCP_SMS_SECRET_KEY=
NCP_SMS_SENDER=

# === OAuth ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === Monitoring ===
SENTRY_DSN=
LOG_LEVEL=INFO
OTEL_ENABLED=false

# === Workers ===
WEB_CONCURRENCY=4

# === Frontend (build args) ===
NEXT_PUBLIC_API_URL=https://api.pickket.kr
NEXT_PUBLIC_BASE_URL=https://www.pickket.kr
NEXT_PUBLIC_CDN_URL=https://www.pickket.kr
NEXT_PUBLIC_IMAGE_HOSTS=

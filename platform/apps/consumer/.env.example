# ─────────────────────────── consumer (v2 마켓플레이스) env ───────────────────────────
# NEXT_PUBLIC_* 는 BUILD TIME 에 주입되어야 한다(Docker --build-arg). 런타임 주입 불가.

# API / URL 베이스
NEXT_PUBLIC_API_URL=http://localhost:8021
NEXT_PUBLIC_BASE_URL=http://localhost:3020
NEXT_PUBLIC_CONSUMER_URL=http://localhost:3020
NEXT_PUBLIC_GO_URL=http://localhost:3021
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_WS_URL=

# ───────────────────────── 결제 PG: Toss Payments ─────────────────────────
# 결제위젯 clientKey(test_gck_*/live_gck_*). 미설정 시 mock 모드.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ───────────────────────── 결제 PG: NICEPAY (신형 API v1) ─────────────────────────
# ⚠️ clientKey 만 프론트에 노출. secretKey 는 consumer 에 두지 않는다(승인·취소·서명·웹훅 전부 v2 소유).
# 결제창 returnUrl = NEXT_PUBLIC_API_URL + /api/v1/payments/nice/return (v2 엔드포인트).
# orderId = v2 prepare 가 채번한 payment_id, mallReserved = consumer.
# 미설정 시 mock 모드(결제창 없이 success?provider=nicepay&reason=confirmed 로 리다이렉트).
NEXT_PUBLIC_NICEPAY_CLIENT_KEY=
# 나이스 상점 계약에 열린 결제수단만 노출(쉼표 구분). 비우면 카드·간편결제·계좌이체·휴대폰 전부 노출.
# 계약에 없는 수단을 고르면 나이스 결제창이 W004 로 멈춘다. 2026-11-27 운영 상점: CARD,BANK
NEXT_PUBLIC_NICE_PAY_METHODS=

# 기능 플래그
NEXT_PUBLIC_FF_RESALE=

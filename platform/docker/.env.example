# =============================================================================
# Pickket Docker Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -- Project ------------------------------------------------------------------
PROJECT_NAME=Pickket
VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=pickket_v2_dev
POSTGRES_USER=pickket_v2
POSTGRES_PASSWORD=pickket_v2_dev_2026
DB_PORT=5435

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6381/0
REDIS_PORT=6381

# -- Backend (FastAPI) --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pickket_v2:pickket_v2_dev_2026@db:5435/pickket_v2_dev
DATABASE_URL_SYNC=postgresql://pickket_v2:pickket_v2_dev_2026@db:5435/pickket_v2_dev
BACKEND_PORT=8021

# -- Celery -------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -- JWT / Auth ---------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3020,http://localhost:3021,http://localhost:3022

# -- Engine -------------------------------------------------------------------
DEFAULT_BATCH_WINDOW_HOURS=48
MAX_BID_QUANTITY=4

# -- Payment ------------------------------------------------------------------
PAYMENT_EXPIRY_MINUTES=15

# -- Identity -----------------------------------------------------------------
IDENTITY_PROVIDER=stub

# -- Resale -------------------------------------------------------------------
RESALE_DEFAULT_MAX_MARKUP_PCT=0.0
RESALE_PLATFORM_FEE_PCT=5.0

# -- SSE ----------------------------------------------------------------------
SSE_KEEPALIVE_SECONDS=30

# -- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3020
NEXT_PUBLIC_API_URL=http://localhost:8021

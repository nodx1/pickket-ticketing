# Pickket Backend Local Example
# Copy values into your local .env as needed.
# ⚠️ 이 파일에는 **이름만** 적는다. 실제 값(키·시크릿)은 절대 커밋하지 않는다.

DATA_GO_KR_API_KEY=

# ── 조직자 메시징 발송 provider (NCP) — W5-PROVIDER ─────────────────────────
# 이름은 go organizer 와 동일하다(같은 자격증명·발신설정을 공유).
# 미설정이면 발송을 시도하지 않고 명확히 실패한다(원장 failed = 조용한 유실 없음).
#
# 🔴 발송 개시 스위치: disabled(기본, 키가 있어도 발송 안 함) | auto(키 있으면 실발송) | ncp(강제)
#    키 주입(준비)과 발송 개시(결정)는 분리한다. 아래 키만 채우면 발송은 아직 안 나간다 —
#    실제 개시는 이 값을 auto/ncp 로 바꾸는 순간이다(리마인더 beat 가 매일 00:00 KST 발화).
ORGANIZER_MESSAGING_PROVIDER=disabled
# NCP IAM 서브계정 공통 인증키 — 이메일·SMS·알림톡 전부 필수(없으면 미배선 스텁)
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
# 카카오 알림톡(SENS AlimTalk) — 채널ID 는 @채널 형식(plusFriendId)
SENS_ALIMTALK_SERVICE_ID=
SENS_ALIMTALK_CHANNEL_ID=
# SMS/LMS(SENS SMS) — 발신번호는 콘솔 사전등록 필요
SENS_SMS_SERVICE_ID=
SENS_SMS_FROM=
# 이메일(NCP Cloud Outbound Mailer) — 발신주소는 도메인 인증(SPF/DKIM/DMARC) 선행 필요
MAILER_SENDER_ADDRESS=
MAILER_SENDER_NAME=PICKKET
# (선택) 샌드박스/리허설용 host 오버라이드 — 운영은 비워둔다(공식 host 기본값)
# NCP_SENS_HOST=
# NCP_MAILER_HOST=
# NCP_API_TIMEOUT_MS=10000

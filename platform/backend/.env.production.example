# Pickket Production Environment Variables
# Copy this to .env and fill in real values

# REQUIRED — App will not start without these
SECRET_KEY=           # min 32 chars, use: openssl rand -hex 32
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/pickket
DATABASE_URL_SYNC=postgresql://user:password@host:5432/pickket
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=80
DB_READ_POOL_SIZE=80
DB_READ_MAX_OVERFLOW=120
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_USE_LIFO=true
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=12000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TXN_TIMEOUT_MS=10000
DB_APPLICATION_NAME=pickket-backend

# Redis
REDIS_URL=redis://host:6379/0
CELERY_BROKER_URL=redis://host:6379/0
CELERY_RESULT_BACKEND=redis://host:6379/1

# PortOne Payment
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
PORTONE_MOCK_MODE=false
PAYMENT_MANUAL_API_ENABLED=false

# Identity Verification
IDENTITY_PROVIDER=pass
PASS_API_KEY=
PASS_API_SECRET=

# CORS (서브도메인 방식)
CORS_ORIGINS=https://www.pickket.kr,https://go.pickket.kr,https://admin.pickket.kr

# Cookie (크로스도메인)
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none

# URLs
PAYMENT_SUCCESS_URL=https://www.pickket.kr/payment/success
PAYMENT_FAIL_URL=https://www.pickket.kr/payment/fail
